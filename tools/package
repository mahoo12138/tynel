#!/bin/zsh
# 组装一个可搬移的 Tynel 发行目录。
#
#   ./tools/package                 # 输出到 out/release/tynel-<commit>-<goos>-<goarch>
#   ./tools/package --out DIR       # 指定输出目录
#   ./tools/package --verify DIR    # 只校验已有目录的 release.json
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
GO=$(find "$ROOT/.work/toolchain" -maxdepth 3 -path '*/bin/go' -type f 2>/dev/null | head -1)
if [[ -z "$GO" ]]; then
  print -u2 -- "找不到隔离 Go 工具链；先在项目根运行 ./tools/toolchain/prep"
  exit 1
fi

if [[ "${1:-}" == "--verify" ]]; then
  cd "$ROOT"
  exec "$GO" run ./tools/release "$@"
fi

"$ROOT/tools/build"
cd "$ROOT"
exec "$GO" run ./tools/release "$@"
