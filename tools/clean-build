#!/bin/zsh
# 在独立的 Git worktree 中从锁文件重建工具和示例。
#
#   ./tools/clean-build                    # 输出到 out/clean/06-05
#   ./tools/clean-build --out DIR          # 指定新的输出目录
#   ./tools/clean-build --tests            # 额外运行 clean tree 的全部 Go 测试
#   ./tools/clean-build --check-remote     # 额外复核上游标签
#
# 这只接受已提交的 HEAD。脚本建立新 worktree，不复用开发目录的 .work、.tynel、
# .upstream、dist、bin 或 out；所有下载、Go 构建缓存和模块缓存都放在新输出目录。
# 目标目录必须尚不存在，避免把旧结果当成这一次的干净结果。
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
OUT=""
RUN_TESTS=0
CHECK_REMOTE=0
while (( $# )); do
  case "$1" in
    --out)
      [[ $# -ge 2 ]] || { print -u2 -- "--out 需要一个目录"; exit 2; }
      OUT=$2
      shift 2
      ;;
    --out=*)
      OUT=${1#--out=}
      shift
      ;;
    --tests)
      RUN_TESTS=1
      shift
      ;;
    --check-remote)
      CHECK_REMOTE=1
      shift
      ;;
    -h|--help)
      print -u2 -- "用法：./tools/clean-build [--out DIR] [--tests] [--check-remote]"
      exit 0
      ;;
    *)
      print -u2 -- "未知参数：$1"
      print -u2 -- "用法：./tools/clean-build [--out DIR] [--tests] [--check-remote]"
      exit 2
      ;;
  esac
done

if [[ -z "$OUT" ]]; then
  OUT="$ROOT/out/clean/06-05"
fi
OUT=${OUT:A}
if [[ -e "$OUT" ]]; then
  print -u2 -- "输出目录已存在：$OUT"
  print -u2 -- "为了不把旧结果当成本次干净构建，请移走它或换一个 --out。"
  exit 1
fi

# 干净树由 HEAD 建立。未提交的跟踪文件不会进入 worktree；如果允许它们存在，
# 脚本会悄悄验证另一个版本，失去“这次源码”的意义。
if ! git -C "$ROOT" diff --quiet || ! git -C "$ROOT" diff --cached --quiet; then
  print -u2 -- "工作区有未提交的跟踪文件；先提交或移走这些改动再运行干净构建。"
  git -C "$ROOT" status --short
  exit 1
fi
COMMIT=$(git -C "$ROOT" rev-parse HEAD)
SHORT=$(git -C "$ROOT" rev-parse --short HEAD)
mkdir -p "$OUT"
TREE="$OUT/source"

print -- "干净构建提交：$COMMIT"
print -- "新 worktree：$TREE"
git -C "$ROOT" worktree add --detach "$TREE" "$COMMIT"

# 这些目录只可能来自开发目录或旧归档。它们不该出现在新 worktree 里；如果
# 出现，后续命令可能读到旧工具，因此直接停止而不是“继续试试”。
for rel in .work .tynel .upstream dist bin out; do
  if [[ -e "$TREE/$rel" ]]; then
    print -u2 -- "干净树中出现不应复用的路径：$TREE/$rel"
    exit 1
  fi
done

CACHE="$OUT/cache"
mkdir -p "$CACHE"
export TYNEL_COMMIT="$SHORT"
export GOCACHE="$CACHE/go-build"
export GOMODCACHE="$CACHE/gomod"
export GOPATH="$CACHE/gopath"
export GOTOOLCHAIN=local
export GOSUMDB=off
export GOPROXY="${TYNEL_GOPROXY:-https://goproxy.cn}"
unset GOFLAGS

LOG="$OUT/steps.log"
mkdir -p "$OUT/outputs"
step() {
  print -r -- "=== $1 ===" | tee -a "$LOG"
}

step "prep"
if (( CHECK_REMOTE )); then
  "$TREE/tools/toolchain/prep" --force --check-remote
else
  "$TREE/tools/toolchain/prep" --force
fi

step "bridge"
"$TREE/bridge/go/build"

step "cli"
"$TREE/tools/build"

if (( RUN_TESTS )); then
  step "tests"
  "$TREE/tools/test"
fi

step "examples"
build_example() {
  local name=$1 want=$2
  shift 2
  local output="$OUT/outputs/$name"
  # 必须从 clean tree 启动：tynel 会先按当前目录找工具链根，从开发根启动
  # 会悄悄复用开发目录的 .work，看起来成功但记录指向旧工具。
  (cd "$TREE" && ./bin/tynel build "$@" -o "$output")
  local got
  got=$("$output")
  if [[ "$got" != "$want" ]]; then
    print -u2 -- "示例 $name 输出不符：实际 $(printf %q "$got")，期望 $(printf %q "$want")"
    return 1
  fi
  if [[ ! -f "$output.build.json" ]]; then
    print -u2 -- "示例 $name 缺少构建记录：$output.build.json"
    return 1
  fi
  python3 - "$output.build.json" "$TREE" <<'PY'
import json
import sys
record = json.load(open(sys.argv[1], encoding="utf-8"))
root = sys.argv[2] + "/"
for field in ("go", "compiler", "toolexec"):
    path = record["tools"][field]
    if not path.startswith(root):
        raise SystemExit("构建记录中的 %s 不在 clean tree：%s" % (field, path))
PY
  print -- "PASS 示例 $name：$got"
}
build_example add "42" "$TREE/examples/add.ts"
build_example choices $'-1\n0\n1\n1\nfalse\n3\ntrue' "$TREE/examples/choices.ts"
build_example collatz $'111\n111\n8\n8\n0' "$TREE/examples/collatz.ts"
build_example quote $'90\n10\n100' --root "$TREE/examples/quote" main.ts

step "package"
case "$(uname -m)" in
  arm64|aarch64) ARCH=arm64 ;;
  x86_64) ARCH=amd64 ;;
  *) print -u2 -- "未知架构：$(uname -m)"; exit 1 ;;
esac
PACKAGE="$TREE/out/release/tynel-$SHORT-darwin-$ARCH"
"$TREE/tools/package" --out "$PACKAGE"
"$TREE/tools/package" --verify "$PACKAGE"

step "space-path"
SPACED="$OUT/搬移 后的编译器"
cp -R "$PACKAGE" "$SPACED"
"$TREE/tools/package" --verify "$SPACED"
SPACE_OUT="$OUT/outputs/space-add"
(cd "$SPACED" && ./bin/tynel build examples/add.ts -o "$SPACE_OUT")
SPACE_GOT=$("$SPACE_OUT")
if [[ "$SPACE_GOT" != "42" ]]; then
  print -u2 -- "搬移后的编译器输出为 $(printf %q "$SPACE_GOT")，期望 42"
  exit 1
fi
python3 - "$SPACE_OUT.build.json" "$SPACED" <<'PY'
import json
import sys
record = json.load(open(sys.argv[1], encoding="utf-8"))
root = sys.argv[2] + "/"
for field in ("go", "compiler", "toolexec"):
    path = record["tools"][field]
    if not path.startswith(root):
        raise SystemExit("搬移记录中的 %s 不在搬移目录：%s" % (field, path))
PY
print -- "PASS 搬移后的编译器：$SPACE_GOT"

step "report"
python3 - "$OUT" "$TREE" "$COMMIT" "$PACKAGE" "$SPACED" "$SHORT" <<'PY'
import hashlib
import json
import os
import platform
import subprocess
import sys
import time

out, tree, commit, package, spaced, short = sys.argv[1:7]

def sha(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()

def load(path):
    with open(path, encoding="utf-8") as f:
        return json.load(f)

def command(*args):
    try:
        return subprocess.check_output(args, text=True, stderr=subprocess.STDOUT).strip()
    except Exception as exc:
        return f"{type(exc).__name__}: {exc}"

prep = load(os.path.join(tree, ".work/toolchain/toolchain.json"))
lock = load(os.path.join(tree, "tools/toolchain/go.lock.json"))
release = load(os.path.join(package, "release.json"))
records = {}
for name in ("add", "choices", "collatz", "quote", "space-add"):
    exe = os.path.join(out, "outputs", name)
    record = exe + ".build.json"
    records[name] = {
        "path": os.path.relpath(exe, out),
        "sha256": sha(exe),
        "bytes": os.path.getsize(exe),
        "buildRecord": load(record) if os.path.exists(record) else None,
    }
steps = [line.strip() for line in open(os.path.join(out, "steps.log"), encoding="utf-8") if line.strip()]
report = {
    "schemaVersion": 1,
    "node": "06.05",
    "generatedAt": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
    "source": {
        "commit": commit,
        "short": short,
        "worktree": tree,
        "headOnly": True,
        "lockSha256": sha(os.path.join(tree, "tools/toolchain/go.lock.json")),
    },
    "host": {
        "uname": command("uname", "-a"),
        "swVers": command("sw_vers", "-productVersion"),
        "cpu": command("sysctl", "-n", "machdep.cpu.brand_string"),
        "goVersion": command("go", "version"),
    },
    "inputs": {
        "go": lock["go"],
        "frontend": lock["frontend"],
    },
    "toolchainReport": prep,
    "userBuilds": records,
    "release": {
        "path": os.path.relpath(package, out),
        "manifestSha256": sha(os.path.join(package, "release.json")),
        "name": release["name"],
        "commit": release["commit"],
        "target": release["target"],
        "fileCount": len(release["files"]),
        "go": release["go"],
        "frontend": release["frontend"],
    },
    "spacePath": {
        "path": spaced,
        "outputSha256": records["space-add"]["sha256"],
        "releaseManifestSha256": sha(os.path.join(spaced, "release.json")),
    },
    "steps": steps,
}
with open(os.path.join(out, "report.json"), "w", encoding="utf-8") as f:
    json.dump(report, f, indent=2, ensure_ascii=False)
    f.write("\n")
with open(os.path.join(out, "environment.txt"), "w", encoding="utf-8") as f:
    f.write(report["host"]["uname"] + "\n")
    f.write("macOS " + report["host"]["swVers"] + "\n")
    f.write(report["host"]["cpu"] + "\n")
    f.write(report["host"]["goVersion"] + "\n")
print("报告：" + os.path.join(out, "report.json"))
print("示例输出：%s（%d 个）" % (os.path.join(out, "outputs"), len(records)))
print("发行目录：%s" % package)
print("搬移目录：%s" % spaced)
PY

print -- "干净构建完成：$OUT"
print -- "构建报告：$OUT/report.json"
print -- "示例输出：$OUT/outputs"
print -- "发行目录：$PACKAGE"
print -- "搬移目录：$SPACED"
