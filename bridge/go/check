#!/bin/zsh
# 受控测试驱动：验证 bridge 的正常路径和错误路径。
#
# 需要先运行 ./bridge/go/build 生成修改版编译器。
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/../.." && pwd)
SDK=$(ls -d "$ROOT"/.work/toolchain/go*-sdk-* 2>/dev/null | head -1)
COMPILE="$ROOT/.work/bridge/compile"
OUT="$ROOT/.work/bridge/out"
FAILED=0

if [[ -z "$SDK" ]]; then
  print -u2 -- "找不到隔离 Go SDK；先在项目根运行 ./tools/toolchain/prep"
  exit 1
fi
if [[ ! -x "$COMPILE" ]]; then
  print -u2 -- "找不到修改版编译器；先运行 ./bridge/go/build"
  exit 1
fi
mkdir -p "$OUT"

pass() { print -- "PASS $1" }
fail() {
  print -u2 -- "FAIL $1"
  FAILED=1
}

# 1. 加法：真实计算并输出 42。
if out=$("$ROOT/bridge/go/run" "$ROOT/examples/ir/add.nir.json" "$OUT/add" 2>/dev/null) && [[ "$out" == "42" ]]; then
  pass "加法输出 42"
else
  fail "加法输出 \"${out-}\"，期望 42"
fi

# 2. 空入口：被建成可执行函数，运行时无输出。
if "$ROOT/bridge/go/run" "$ROOT/bridge/go/testdata/empty.nir.json" "$OUT/empty" >"$OUT/empty.out" 2>/dev/null && [[ ! -s "$OUT/empty.out" ]]; then
  pass "空入口可执行且无输出"
else
  fail "空入口不可执行或产生了输出"
fi

# 3. boolean：false 取反后输出 true，参数与结果都走 Go 的 bool。
if out=$("$ROOT/bridge/go/run" "$ROOT/bridge/go/testdata/bool.nir.json" "$OUT/bool" 2>/dev/null) && [[ "$out" == "true" ]]; then
  pass "boolean 输出 true"
else
  fail "boolean 输出 \"${out-}\"，期望 true"
fi

# 4. 分支：同一个函数按参数走 then 或 else，两次调用输出 1 和 2。
if out=$("$ROOT/bridge/go/run" "$ROOT/bridge/go/testdata/branch.nir.json" "$OUT/branch" 2>/dev/null) && [[ "$out" == $'1\n2' ]]; then
  pass "if 分支按条件输出"
else
  fail "if 分支输出 \"${out-}\"，期望 1 和 2"
fi

# 5. 返回路径：两臂都返回，return 之后的不可达打印不生成。
if out=$("$ROOT/bridge/go/run" "$ROOT/bridge/go/testdata/returns.nir.json" "$OUT/returns" 2>/dev/null) && [[ "$out" == $'1\n2\n1' ]]; then
  pass "完整返回路径与不可达语句"
else
  fail "返回路径输出 \"${out-}\"，期望 1、2、1"
fi

# 6. 短路：false && 与 true || 都跳过右侧，结果绑定到临时值。
if out=$("$ROOT/bridge/go/run" "$ROOT/bridge/go/testdata/short.nir.json" "$OUT/short" 2>/dev/null) && [[ "$out" == $'1\nfalse\n3\ntrue' ]]; then
  pass "短路跳过右侧并绑定结果"
else
  fail "短路输出 \"${out-}\"，期望 1、false、3、true"
fi

# 7. 三元式：只执行选中的分支，结果绑定到临时值。
if out=$("$ROOT/bridge/go/run" "$ROOT/bridge/go/testdata/ternary.nir.json" "$OUT/ternary" 2>/dev/null) && [[ "$out" == $'1\n10\n4\n20' ]]; then
  pass "三元式只执行选中分支"
else
  fail "三元式输出 \"${out-}\"，期望 1、10、4、20"
fi

# 8. 赋值：先算右值，再写回可变的 let。
if out=$("$ROOT/bridge/go/run" "$ROOT/bridge/go/testdata/assign.nir.json" "$OUT/assign" 2>/dev/null) && [[ "$out" == "2" ]]; then
  pass "赋值先算右值再写回"
else
  fail "赋值输出 \"${out-}\"，期望 2"
fi

# 9. while：条件每轮重新检查，循环体反复写回。
if out=$("$ROOT/bridge/go/run" "$ROOT/bridge/go/testdata/while.nir.json" "$OUT/while" 2>/dev/null) && [[ "$out" == "55" ]]; then
  pass "while 反复检查条件并累加"
else
  fail "while 输出 \"${out-}\"，期望 55"
fi

# 10. break / continue：跳到最近循环，continue 回到条件检查。
if out=$("$ROOT/bridge/go/run" "$ROOT/bridge/go/testdata/jump.nir.json" "$OUT/jump" 2>/dev/null) && [[ "$out" == $'3\n1\n3' ]]; then
  pass "break 与 continue 跳到最近循环"
else
  fail "跳转输出 \"${out-}\"，期望 3、1、3"
fi

# 11. 坏 NIR：调用不存在的函数，必须在编译期被拒绝。
if msg=$("$ROOT/bridge/go/run" "$ROOT/bridge/go/testdata/bad-call.nir.json" "$OUT/bad" 2>&1); then
  fail "坏 NIR 竟然构建成功"
elif [[ "$msg" == *"tynel bridge"*"不存在的函数"* ]]; then
  pass "坏 NIR 在编译期被拒绝"
else
  fail "坏 NIR 的错误信息不符：$msg"
fi

# 12. 普通构建：不设置 TYNEL_NIR 时，替换编译器不改变行为。
if out=$(TYNEL_COMPILE="$COMPILE" "$SDK/bin/go" run -toolexec="$ROOT/bridge/go/toolexec" "$ROOT/bridge/go/testdata/hello" 2>&1) && [[ "$out" == "hello" ]]; then
  pass "普通构建不受影响"
else
  fail "普通构建输出 \"${out-}\""
fi

# 13. 支持签名不对：缺少 tynelPrintFloat64 时必须拒绝。
if msg=$(TYNEL_NIR="$ROOT/examples/ir/add.nir.json" TYNEL_COMPILE="$COMPILE" "$SDK/bin/go" build \
  -toolexec="$ROOT/bridge/go/toolexec" -tags "tynel_missing_$$" -o "$OUT/missing" \
  "$ROOT/bridge/go/testdata/support-missing" 2>&1); then
  fail "缺少支持函数竟然构建成功"
elif [[ "$msg" == *"缺少固定支持函数"* ]]; then
  pass "缺少支持函数被拒绝"
else
  fail "缺支持函数的错误信息不符：$msg"
fi

# 14. 非 main 入口：bridge 生成 main 包装转发到 entry，链路一路调到辅助函数。
if out=$("$ROOT/bridge/go/run" "$ROOT/bridge/go/testdata/entry.nir.json" "$OUT/entry" 2>/dev/null) && [[ "$out" == "42" ]]; then
  pass "非 main 入口经包装转发输出 42"
else
  fail "非 main 入口输出 \"${out-}\"，期望 42"
fi

# 15. 入口不存在：bridge/go/run 不经 nir.Verify，bridge 自己必须在编译期拒绝。
if msg=$("$ROOT/bridge/go/run" "$ROOT/bridge/go/testdata/entry-missing.nir.json" "$OUT/entry-missing" 2>&1); then
  fail "入口不存在的 NIR 竟然构建成功"
elif [[ "$msg" == *"tynel bridge"*"入口函数"*"不存在"* ]]; then
  pass "入口不存在在编译期被拒绝"
else
  fail "入口不存在的错误信息不符：$msg"
fi

# 16. 入口与 main 冲突：NIR 里已有 main 函数时不能再造包装，必须明确拒绝。
if msg=$("$ROOT/bridge/go/run" "$ROOT/bridge/go/testdata/entry-conflict.nir.json" "$OUT/entry-conflict" 2>&1); then
  fail "入口与 main 冲突的 NIR 竟然构建成功"
elif [[ "$msg" == *"tynel bridge"*"无法生成入口包装"* ]]; then
  pass "入口与 main 冲突在编译期被拒绝"
else
  fail "入口冲突的错误信息不符：$msg"
fi

exit $FAILED
